# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Music
MUSIC_FILE=music/background.mp3

# Meta / Instagram Graph API Configuration
META_APP_ID=your_meta_app_id
META_CONFIG_ID=your_meta_config_id
META_SYSTEM_USER_ID=your_system_user_id
META_INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
META_ACCESS_TOKEN=your_meta_access_token
META_API_VERSION=v27.0
META_APP_SECRET=your_meta_app_secret

# WhatsApp Cloud API Configuration
WHATSAPP_API_VERSION=v27.0
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_PHONE=+91XXXXXXXXXX
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_AUTO_PUBLISH=true
WHATSAPP_ALLOWED_SENDERS=91XXXXXXXXXX
